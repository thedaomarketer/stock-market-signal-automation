# Postgres connection string (Neon: use the pooled connection string)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Signing secret from KamdenAI Developer webhooks. Deliveries are rejected until this is set.
KAMDENAI_SIGNING_SECRET=whsec_example_do_not_commit

# Password you use to log into the dashboard
DASHBOARD_PASSWORD=change-me

# Random string (32+ chars) used to sign the login cookie. Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string
